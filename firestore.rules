rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // users/{uid}: private profile; uid/fullName/email/profilePic/age are
    //   strings, hobbies/groups are bounded lists, and legacy fcmToken is an
    //   optional private string. UID, email, and legacy token are immutable.
    // users_public/{uid}: uid/fullName/profilePic strings only; uid is immutable.
    // fcmTokens/{sha256(uid:token)}: uid/token strings and updatedAt timestamp;
    //   clients may write only their own record and cannot read token records.
    // groups/{groupId}: groupName/category/groupIcon/admin/adminName strings,
    //   members list, groupId string, recentMessage/recentMessageSender/
    //   recentMessageId strings, recentMessageTime integer or timestamp, and
    //   immutable createdAt timestamp. Only members can read this private doc.
    // groups/{groupId}/messages/{messageId}: immutable groupId/message/sender/
    //   senderId strings and time timestamp; only members can read or create.
    //   Worker-only pushDispatchStatus/pushDispatchClaimedAt fields are never
    //   client-writable.
    // groups/{groupId}/members/{uid}: immutable uid/groupId strings and
    //   createdAt timestamp; each user can manage only their own marker.
    // groupDirectory/{groupId}: groupId/groupName/category/groupIcon/adminName
    //   strings and createdAt timestamp; searchable metadata contains no
    //   member list, email, or message content.
    // categary/{id}: existing category documents; authenticated read-only.
    // notificationRateLimits/{uid}: Worker-only rate-limit metadata.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function validString(value, minimum, maximum) {
      return value is string &&
        value.size() >= minimum &&
        value.size() <= maximum;
    }

    function validUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'fullName', 'email', 'profilePic', 'age', 'hobbies', 'groups'
        ]) &&
        data.keys().hasOnly([
          'uid', 'fullName', 'email', 'profilePic', 'age', 'hobbies',
          'groups', 'fcmToken'
        ]) &&
        data.uid == userId &&
        validString(data.fullName, 1, 80) &&
        validString(data.email, 3, 320) &&
        data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
        validString(data.profilePic, 0, 2048) &&
        validString(data.age, 1, 3) &&
        data.age.matches('^[0-9]{1,3}$') &&
        data.hobbies is list &&
        data.hobbies.size() <= 50 &&
        data.hobbies.hasOnly([
          'Art', 'Animal care', 'Fashion', 'Cars', 'Education', 'Games',
          'History', 'Music', 'Social', 'Sport'
        ]) &&
        data.groups is list &&
        data.groups.size() == 0 &&
        (!('fcmToken' in data) ||
          validString(data.fcmToken, 1, 4096));
    }

    function publicProfileMatchesPrivate(userId, data) {
      let publicPath =
        /databases/$(database)/documents/users_public/$(userId);
      return existsAfter(publicPath) &&
        getAfter(publicPath).data.uid == userId &&
        getAfter(publicPath).data.fullName == data.fullName &&
        getAfter(publicPath).data.profilePic == data.profilePic;
    }

    function validPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'profilePic']) &&
        data.keys().hasOnly(['uid', 'fullName', 'profilePic']) &&
        data.uid == userId &&
        validString(data.fullName, 1, 80) &&
        validString(data.profilePic, 0, 2048);
    }

    function privateProfileMatchesPublic(userId, data) {
      let privatePath = /databases/$(database)/documents/users/$(userId);
      return existsAfter(privatePath) &&
        getAfter(privatePath).data.uid == userId &&
        getAfter(privatePath).data.fullName == data.fullName &&
        getAfter(privatePath).data.profilePic == data.profilePic;
    }

    function validToken(data, userId, tokenHash) {
      return data.keys().hasAll(['uid', 'token', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'token', 'updatedAt']) &&
        data.uid == userId &&
        tokenHash.matches('^[a-f0-9]{64}$') &&
        validString(data.token, 1, 4096) &&
        data.updatedAt == request.time;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function membershipPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(userId);
    }

    function containsCurrentMember(members, userId) {
      let profilePath =
        /databases/$(database)/documents/users_public/$(userId);
      return members is list &&
        (members.hasAny([userId]) ||
          (exists(profilePath) &&
            members.hasAny([
              userId + '_' + get(profilePath).data.fullName
            ])));
    }

    function removedLegacyMemberIsCurrentUser(removedMembers, userId) {
      return removedMembers.size() == 0 ||
        (removedMembers.size() == 1 &&
          removedMembers[0] is string &&
          removedMembers[0].matches('^' + userId + '_.*$'));
    }

    function isGroupMember(groupId) {
      let path = groupPath(groupId);
      return isAuthenticated() &&
        exists(path) &&
        (containsCurrentMember(get(path).data.members, request.auth.uid) ||
          exists(membershipPath(groupId, request.auth.uid)));
    }

    function isMemberInGroupData(groupId, data) {
      return isAuthenticated() &&
        (containsCurrentMember(data.members, request.auth.uid) ||
          exists(membershipPath(groupId, request.auth.uid)));
    }

    function validGroup(data, groupId) {
      return data.keys().hasAll([
          'groupName', 'category', 'groupIcon', 'admin', 'adminName',
          'members', 'groupId', 'recentMessage', 'recentMessageSender',
          'recentMessageTime', 'recentMessageId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'groupName', 'category', 'groupIcon', 'admin', 'adminName',
          'members', 'groupId', 'recentMessage', 'recentMessageSender',
          'recentMessageTime', 'recentMessageId', 'createdAt'
        ]) &&
        data.groupId == groupId &&
        validString(data.groupName, 1, 80) &&
        validString(data.category, 1, 80) &&
        validString(data.groupIcon, 0, 2048) &&
        validString(data.admin, 1, 128) &&
        validString(data.adminName, 1, 80) &&
        data.members is list &&
        data.members.size() >= 1 &&
        data.members.size() <= 500 &&
        data.members.toSet().size() == data.members.size() &&
        validString(data.recentMessage, 0, 4000) &&
        validString(data.recentMessageSender, 0, 80) &&
        (data.recentMessageTime is timestamp ||
          (data.recentMessageTime is int &&
            data.recentMessageTime > 0 &&
            data.recentMessageTime < 4102444800000)) &&
        validString(data.recentMessageId, 0, 150) &&
        data.createdAt is timestamp;
    }

    function validGroupDirectory(data, groupId) {
      return data.keys().hasAll([
          'groupId', 'groupName', 'category', 'groupIcon', 'adminName',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'groupName', 'category', 'groupIcon', 'adminName',
          'createdAt'
        ]) &&
        data.groupId == groupId &&
        validString(data.groupName, 1, 80) &&
        validString(data.category, 1, 80) &&
        validString(data.groupIcon, 0, 2048) &&
        validString(data.adminName, 1, 80) &&
        data.createdAt is timestamp;
    }

    function validMessage(data, groupId, senderId) {
      let profilePath =
        /databases/$(database)/documents/users_public/$(senderId);
      return data.keys().hasAll([
          'groupId', 'message', 'sender', 'senderId', 'time'
        ]) &&
        data.keys().hasOnly([
          'groupId', 'message', 'sender', 'senderId', 'time'
        ]) &&
        data.groupId == groupId &&
        data.senderId == senderId &&
        validString(data.message, 1, 4000) &&
        validString(data.sender, 1, 80) &&
        exists(profilePath) &&
        data.sender == get(profilePath).data.fullName &&
        data.time is timestamp &&
        data.time <= request.time;
    }

    function validMembership(data, groupId, userId) {
      return data.keys().hasAll(['uid', 'groupId', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'groupId', 'createdAt']) &&
        data.uid == userId &&
        data.groupId == groupId &&
        data.createdAt == request.time;
    }

    function validMembershipChange(groupId) {
      let oldMembers = resource.data.members;
      let newMembers = request.resource.data.members;
      let memberPath = membershipPath(groupId, request.auth.uid);
      let oldMembersWithoutUid = oldMembers.removeAll([request.auth.uid]);
      let removedLegacyMembers =
        oldMembersWithoutUid.removeAll(newMembers);
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['members']) &&
        newMembers is list &&
        newMembers.size() >= 1 &&
        newMembers.size() <= 500 &&
        newMembers.toSet().size() == newMembers.size() &&
        ((newMembers.hasAll(oldMembers) &&
            newMembers.size() == oldMembers.size() + 1 &&
            !containsCurrentMember(oldMembers, request.auth.uid) &&
            containsCurrentMember(newMembers, request.auth.uid) &&
            existsAfter(memberPath)) ||
          (oldMembersWithoutUid.hasAll(newMembers) &&
            oldMembersWithoutUid.size() >= newMembers.size() &&
            oldMembersWithoutUid.size() <= newMembers.size() + 1 &&
            removedLegacyMemberIsCurrentUser(
              removedLegacyMembers, request.auth.uid
            ) &&
            containsCurrentMember(oldMembers, request.auth.uid) &&
            !containsCurrentMember(newMembers, request.auth.uid) &&
            !existsAfter(memberPath)) ||
          (newMembers == oldMembers &&
            containsCurrentMember(oldMembers, request.auth.uid) &&
            existsAfter(memberPath)));
    }

    function validRecentMessageUpdate(groupId) {
      let messagePath =
        /databases/$(database)/documents/groups/$(groupId)/messages/$(request.resource.data.recentMessageId);
      return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'recentMessage', 'recentMessageSender', 'recentMessageTime',
            'recentMessageId'
          ]) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['recentMessageId']) &&
        existsAfter(messagePath) &&
        getAfter(messagePath).data.groupId == groupId &&
        getAfter(messagePath).data.senderId == request.auth.uid &&
        getAfter(messagePath).data.message ==
          request.resource.data.recentMessage &&
        getAfter(messagePath).data.sender ==
          request.resource.data.recentMessageSender &&
        getAfter(messagePath).data.time ==
          request.resource.data.recentMessageTime;
    }

    function directoryMatchesGroup(groupId, data, afterWrite) {
      let path = groupPath(groupId);
      return afterWrite
        ? existsAfter(path) &&
          getAfter(path).data.groupId == data.groupId &&
          getAfter(path).data.groupName == data.groupName &&
          getAfter(path).data.category == data.category &&
          getAfter(path).data.groupIcon == data.groupIcon &&
          getAfter(path).data.adminName == data.adminName &&
          getAfter(path).data.createdAt == data.createdAt
        : exists(path) &&
          get(path).data.groupId == data.groupId &&
          get(path).data.groupName == data.groupName &&
          get(path).data.category == data.category &&
          get(path).data.groupIcon == data.groupIcon &&
          get(path).data.adminName == data.adminName &&
          get(path).data.createdAt == data.createdAt;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        validUserProfile(request.resource.data, userId) &&
        request.resource.data.email == request.auth.token.email &&
        uidUnchanged(userId) &&
        publicProfileMatchesPrivate(userId, request.resource.data);
      allow update: if isOwner(userId) &&
        validUserProfile(request.resource.data, userId) &&
        uidNotModified() &&
        request.resource.data.email == resource.data.email &&
        !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['fcmToken', 'uid', 'email']) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'fullName', 'profilePic', 'age', 'hobbies', 'groups'
          ]) &&
        publicProfileMatchesPrivate(userId, request.resource.data);
      allow delete: if false;
    }

    match /users_public/{userId} {
      allow get, list: if isAuthenticated();
      allow create: if isOwner(userId) &&
        validPublicProfile(request.resource.data, userId) &&
        uidUnchanged(userId) &&
        privateProfileMatchesPublic(userId, request.resource.data);
      allow update: if isOwner(userId) &&
        validPublicProfile(request.resource.data, userId) &&
        uidNotModified() &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['fullName', 'profilePic']) &&
        privateProfileMatchesPublic(userId, request.resource.data);
      allow delete: if false;
    }

    match /fcmTokens/{tokenHash} {
      allow read: if false;
      allow create: if isAuthenticated() &&
        validToken(request.resource.data, request.auth.uid, tokenHash);
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        validToken(request.resource.data, request.auth.uid, tokenHash);
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      allow get, list: if isMemberInGroupData(groupId, resource.data);
      allow create: if isAuthenticated() &&
        validGroup(request.resource.data, groupId) &&
        request.resource.data.admin == request.auth.uid &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == request.auth.uid &&
        request.resource.data.adminName ==
          get(/databases/$(database)/documents/users_public/$(request.auth.uid))
            .data.fullName &&
        request.resource.data.createdAt == request.time &&
        existsAfter(
          /databases/$(database)/documents/groupDirectory/$(groupId)
        );
      allow update: if isAuthenticated() &&
        validGroup(request.resource.data, groupId) &&
        request.resource.data.admin == resource.data.admin &&
        request.resource.data.adminName == resource.data.adminName &&
        request.resource.data.groupName == resource.data.groupName &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.groupIcon == resource.data.groupIcon &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (validMembershipChange(groupId) ||
          (isGroupMember(groupId) &&
            validRecentMessageUpdate(groupId)));
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) &&
          validMessage(request.resource.data, groupId, request.auth.uid);
        allow update, delete: if false;
      }

      match /members/{memberUid} {
        allow get: if isOwner(memberUid) &&
          exists(groupPath(groupId)) &&
          (containsCurrentMember(
              get(groupPath(groupId)).data.members, memberUid
            ) ||
            exists(membershipPath(groupId, memberUid)));
        allow list: if false;
        allow create: if isOwner(memberUid) &&
          validMembership(request.resource.data, groupId, memberUid) &&
          (containsCurrentMember(
              getAfter(groupPath(groupId)).data.members, memberUid
            ) ||
            (exists(groupPath(groupId)) &&
              containsCurrentMember(
                get(groupPath(groupId)).data.members, memberUid
              )));
        allow update: if false;
        allow delete: if isOwner(memberUid) &&
          resource.data.uid == memberUid &&
          !containsCurrentMember(
            getAfter(groupPath(groupId)).data.members, memberUid
          ) &&
          !existsAfter(membershipPath(groupId, memberUid));
      }
    }

    match /groupDirectory/{groupId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        validGroupDirectory(request.resource.data, groupId) &&
        directoryMatchesGroup(groupId, request.resource.data, true) &&
        containsCurrentMember(
          getAfter(groupPath(groupId)).data.members, request.auth.uid
        );
      allow update: if isAuthenticated() &&
        validGroupDirectory(request.resource.data, groupId) &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'groupName', 'category', 'groupIcon', 'adminName'
          ]) &&
        directoryMatchesGroup(groupId, request.resource.data, false) &&
        isGroupMember(groupId);
      allow delete: if false;
    }

    match /categary/{categoryId} {
      allow get, list: if isAuthenticated();
      allow create, update, delete: if false;
    }

    match /notificationRateLimits/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
